# Public app URL, e.g. https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Admin login. Use strong random values in Vercel.
ADMIN_PASSCODE=change-me-now
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY
SUPABASE_STORAGE_BUCKET=asset-files

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=gbp

# Resend
RESEND_API_KEY=re_xxx
RESEND_FROM=The Craftist Exchange <alerts@yourdomain.co.uk>
ADMIN_NOTIFY_EMAIL=you@yourdomain.co.uk

# Supplier/automation ingest endpoint
INGEST_SECRET=replace-with-random-ingest-secret

# Vercel Cron security. Vercel sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=replace-with-random-cron-secret
